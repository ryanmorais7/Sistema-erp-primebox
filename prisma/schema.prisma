// PrimeBox ERP — schema de dados
// Ver /docs/decisoes/ADR-002-modelo-cliente-produto.md para o racional
// de cada decisão de modelagem.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  DESENVOLVEDOR
  ADMINISTRADOR
  FUNCIONARIO
}

model Usuario {
  id                   String       @id @default(cuid())
  nome                 String
  email                String       @unique
  senhaHash            String?
  papel                PapelUsuario @default(FUNCIONARIO)
  ativo                Boolean      @default(true)
  tokenConviteHash     String?      @unique
  tokenConviteExpiraEm DateTime?
  tentativasFalhas     Int          @default(0)
  bloqueadoAte         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Cliente {
  id           String  @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String? @unique
  cpf          String? @unique
  telefone     String
  email        String?
  contatoNome  String?

  endereco String?
  numero   String?
  bairro   String?
  cidade   String?
  estado   String?
  cep      String?

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos          Pedido[]
  itensOrdemAvulsa ItemOrdemAvulsa[]
}

enum TipoProduto {
  BASE
  UNIBOX
  BAU
}

model Medida {
  id        String   @id @default(cuid())
  nome      String   @unique
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]
}

model Produto {
  id            String      @id @default(cuid())
  nome          String
  tipo          TipoProduto
  medidaId      String
  medida        Medida      @relation(fields: [medidaId], references: [id])
  tecido        String?
  cor           String?
  preco         Decimal     @db.Decimal(10, 2)
  custo         Decimal     @default(0) @db.Decimal(10, 2)
  estoqueMinimo Decimal     @default(0) @db.Decimal(10, 2)
  ativo         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  itensPedido       ItemPedido[]
  itensOrdemAvulsa  ItemOrdemAvulsa[]
  movimentosEstoque MovimentoEstoqueProduto[]
  fichaTecnica      ConsumoMateriaPrima[]
}

enum StatusPedido {
  EM_CARTEIRA
  FATURADO
}

model Pedido {
  id          String       @id @default(cuid())
  numero      Int          @unique @default(autoincrement())
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  status      StatusPedido @default(EM_CARTEIRA)
  valorTotal  Decimal      @db.Decimal(10, 2)
  observacoes String?
  itens       ItemPedido[]
  expedicao   Expedicao?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  custoUnitario Decimal @default(0) @db.Decimal(10, 2)
  // Item resolvido direto do saldo em estoque, sem passar por produção
  // (ver ADR de conexão Estoque + Pedidos). Mutuamente exclusivo com
  // ordemProducao na prática, mas não modelado como tal no banco.
  atendidoEstoque Boolean @default(false)

  ordemProducao OrdemProducao?
}

enum StatusOrdemProducao {
  AGUARDANDO
  EM_PRODUCAO
  CONCLUIDO
}

model OrdemProducao {
  id           String              @id @default(cuid())
  numero       Int                 @unique @default(autoincrement())
  itemPedidoId String              @unique
  itemPedido   ItemPedido          @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  status       StatusOrdemProducao @default(AGUARDANDO)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// OP avulsa: produção rápida sem Pedido/Cliente formal (ex: venda pra
// um conhecido, "Avulso" na planilha do Pedro). Numeração própria
// ("OP Avulsa #N"), fora do alcance dos relatórios de Faturamento e
// "Por cliente" — ver ADR-033. Cada linha tem seu próprio status,
// espelhando o ItemPedido/OrdemProducao do fluxo formal.
model OrdemAvulsa {
  id        String   @id @default(cuid())
  numero    Int      @unique @default(autoincrement())
  createdAt DateTime @default(now())

  itens ItemOrdemAvulsa[]
}

model ItemOrdemAvulsa {
  id            String   @id @default(cuid())
  ordemAvulsaId String
  ordemAvulsa   OrdemAvulsa @relation(fields: [ordemAvulsaId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  quantidade    Int
  // Nome digitado livremente — é o dado que aparece pro usuário. clienteId
  // é só um vínculo informativo opcional (nunca usado pelos relatórios
  // financeiros, que continuam olhando só pra Pedido/Cliente).
  clienteTexto  String
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  observacao    String?
  // Preço opcional, só pra referência (recibo/consulta) — mesmo assim
  // entra no Faturamento por período e no Painel quando concluído (ver
  // ADR-033), igual a um Pedido faturado.
  precoUnitario Decimal? @db.Decimal(10, 2)
  // Se o cliente já pagou essa venda avulsa — controle simples e binário
  // (sem vencimento/atraso), separado do status de produção: concluir a
  // produção já conta como ganho no Painel independente disso, então
  // esse campo é só pra saber se o dinheiro já entrou de fato. Padrão
  // pendente porque produção avulsa raramente é paga por antecipado.
  pago          Boolean @default(false)
  // Data pra qual a produção está programada — opcional, em branco
  // significa "sem data específica" (produção imediata/hoje). Só
  // informativo por enquanto, não filtra nem ordena o board.
  dataProgramada DateTime? @db.Date
  status        StatusOrdemProducao @default(AGUARDANDO)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expedicao Expedicao?
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
}

model MateriaPrima {
  id            String   @id @default(cuid())
  nome          String
  unidade       String
  estoqueMinimo Decimal  @default(0) @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movimentos MovimentoEstoqueMateriaPrima[]
  precos     PrecoMateriaPrima[]
  consumos   ConsumoMateriaPrima[]
}

model Fornecedor {
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  precos PrecoMateriaPrima[]
}

// Preço de uma matéria-prima cotado por um fornecedor específico, na
// unidade de medida já cadastrada na MateriaPrima (ex: R$/m, R$/placa).
// Uma matéria-prima pode ter vários fornecedores, para comparação.
model PrecoMateriaPrima {
  id             String       @id @default(cuid())
  materiaPrimaId String
  materiaPrima   MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  fornecedorId   String
  fornecedor     Fornecedor   @relation(fields: [fornecedorId], references: [id])
  valor          Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([materiaPrimaId, fornecedorId])
}

// Ficha técnica: quanto de uma matéria-prima um produto consome por
// unidade produzida. Usado para dar saída automática no estoque de
// matéria-prima quando uma Ordem de Produção é concluída.
model ConsumoMateriaPrima {
  id             String       @id @default(cuid())
  produtoId      String
  produto        Produto      @relation(fields: [produtoId], references: [id])
  materiaPrimaId String
  materiaPrima   MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  quantidade     Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([produtoId, materiaPrimaId])
}

model MovimentoEstoqueProduto {
  id         String               @id @default(cuid())
  produtoId  String
  produto    Produto              @relation(fields: [produtoId], references: [id])
  tipo       TipoMovimentoEstoque
  quantidade Decimal              @db.Decimal(10, 2)
  observacao String?
  createdAt  DateTime             @default(now())
}

model MovimentoEstoqueMateriaPrima {
  id             String               @id @default(cuid())
  materiaPrimaId String
  materiaPrima   MateriaPrima         @relation(fields: [materiaPrimaId], references: [id])
  tipo           TipoMovimentoEstoque
  quantidade     Decimal              @db.Decimal(10, 2)
  observacao     String?
  createdAt      DateTime             @default(now())
}

enum StatusExpedicao {
  AGUARDANDO
  EM_ROTA
  ENTREGUE
}

// pedidoId e itemOrdemAvulsaId são mutuamente exclusivos (uma expedição
// vem do fluxo formal OU de uma linha de OP avulsa, nunca dos dois) —
// não modelado como tal no banco, garantido na camada de ação.
model Expedicao {
  id                String          @id @default(cuid())
  numero            Int             @unique @default(autoincrement())
  pedidoId          String?         @unique
  pedido            Pedido?         @relation(fields: [pedidoId], references: [id])
  itemOrdemAvulsaId String?         @unique
  itemOrdemAvulsa   ItemOrdemAvulsa? @relation(fields: [itemOrdemAvulsaId], references: [id])
  transportadora    String?
  status            StatusExpedicao @default(AGUARDANDO)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
