# Copie este arquivo para .env e ajuste as credenciais do seu PostgreSQL local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primebox_erp?schema=public"

# Chave usada pra assinar o cookie de sessão do login — gere a sua com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="gere-sua-propria-chave-aqui"
